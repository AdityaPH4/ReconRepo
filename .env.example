# ─────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────

# ── Postgres — queryable reconciliation data ─────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/toit_recon?schema=public"

# ── S3 — raw uploaded files, stored byte-for-byte as received ────────────
S3_REGION="ap-south-1"
S3_BUCKET="toit-recon-raw"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Set only for S3-compatible storage (MinIO, R2); leave blank for real AWS S3.
S3_ENDPOINT=""

# ── API ─────────────────────────────────────────────────────────────────
API_PORT="4000"
# Comma-separated origins allowed to call the API.
CORS_ORIGIN="http://localhost:3000"

# ── Auth ────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
SESSION_TTL_HOURS="12"

# ── Web ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
