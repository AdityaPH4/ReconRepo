# Lambda container image — built from the repo root:
# `docker build -f apps/api/Dockerfile.lambda -t <ecr-repo>:latest .`
#
# Same build stage as `apps/api/Dockerfile` (already verified working); only
# the runtime stage differs — AWS's Lambda Node.js base image instead of
# plain node:22-alpine, and CMD points at the Lambda handler instead of
# `node apps/api/dist/server.js`.

FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/recon-core/package.json packages/recon-core/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/mpr-core/package.json packages/mpr-core/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
RUN npm ci

COPY packages packages
COPY apps/api apps/api
RUN npm run build:packages && npm run build --workspace @toit/api
RUN npm prune --omit=dev

FROM public.ecr.aws/lambda/nodejs:22
WORKDIR ${LAMBDA_TASK_ROOT}
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/packages ./packages
COPY --from=build /app/apps/api ./apps/api

CMD ["apps/api/dist/lambda.handler"]
